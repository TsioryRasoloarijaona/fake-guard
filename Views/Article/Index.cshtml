@model IEnumerable<fk_news_detector.Models.ViewModels.ResultDisplayVM>
@{
    ViewBag.Title = "Analysis History";
}

<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h1>Analysis History</h1>
            <p>All articles previously submitted for analysis.</p>
        </div>
        <a href="@Url.Action("Submit", "Article")" class="btn btn-accent">
            + New Analysis
        </a>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    No articles analyzed yet.
                    <a href="@Url.Action("Submit", "Article")">Submit your first article →</a>
                </div>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var article in Model)
                    {
                        <a href="@Url.Action("Details", "Result", new { id = article.ArticleId })"
                           class="list-group-item list-group-item-action">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <p class="mb-1 font-weight-bold">@article.Title</p>
                                    @if (!string.IsNullOrWhiteSpace(article.SourceUrl))
                                    {
                                        <small class="text-muted">@article.SourceUrl</small><br />
                                    }
                                    <small class="text-muted">@article.SubmittedAt.ToString("dd MMM yyyy, HH:mm") UTC</small>
                                </div>
                                <div class="text-right ml-3 flex-shrink-0">
                                    <span class="badge badge-@article.BadgeClass badge-pill">@article.Verdict</span><br />
                                    <small class="text-muted">@article.ConfidencePct%</small>
                                </div>
                            </div>
                        </a>
                    }
                </ul>
            }

        </div>
    </div>
</div>
