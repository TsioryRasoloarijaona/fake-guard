@model fk_news_detector.Models.ViewModels.ResultDisplayVM
@{
    ViewBag.Title = "Analysis Result";
}

<div class="page-header">
    <div class="container">
        <h1>Analysis Result</h1>
        <p>Completed — @Model.SubmittedAt.ToString("dd MMM yyyy, HH:mm") UTC</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <!-- 1. Verdict Card -->
            <div class="card shadow mb-4 verdict-card border-@Model.BadgeClass">
                <div class="card-body text-center py-5">
                    <i class="bi @Model.VerdictIcon verdict-emoji"></i>
                    <span class="badge badge-@Model.BadgeClass badge-pill verdict-badge mb-3">@Model.Verdict</span>
                    <div class="mb-3">
                        <small class="text-muted font-weight-bold text-uppercase">Confidence Score</small>
                        <div class="progress mt-2">
                            <div class="progress-bar bg-@Model.BadgeClass"
                                 role="progressbar"
                                 style="width: @Model.ConfidencePct%"
                                 aria-valuenow="@Model.ConfidencePct"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                                @Model.ConfidencePct%
                            </div>
                        </div>
                    </div>
                    <small class="text-muted">Model: @(Model.ModelName ?? "FakeGuard v1")</small>
                </div>
            </div>

            <!-- 2. Article Details Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title font-weight-bold mb-3">Article Details</h5>
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Title</dt>
                        <dd class="col-sm-9">@Model.Title</dd>

                        @if (!string.IsNullOrWhiteSpace(Model.SourceUrl))
                        {
                            <dt class="col-sm-3 text-muted">Source</dt>
                            <dd class="col-sm-9">
                                <a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer">
                                    @Model.SourceUrl
                                </a>
                            </dd>
                        }

                        <dt class="col-sm-3 text-muted">Submitted</dt>
                        <dd class="col-sm-9 mb-0">@Model.SubmittedAt.ToString("dd MMM yyyy, HH:mm") UTC</dd>
                    </dl>
                </div>
            </div>

            <!-- 3. Article Content Card -->
            @{
                var preview = Model.Content.Length > 300
                    ? Model.Content.Substring(0, 300).TrimEnd() + "…"
                    : Model.Content;
                var hasMore = Model.Content.Length > 300;
            }
            @if (!string.IsNullOrWhiteSpace(Model.Content))
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="card-title font-weight-bold mb-3">Article Content</h5>
                        <p id="article-preview" class="text-muted mb-2" style="white-space: pre-wrap;">@preview</p>
                        @if (hasMore)
                        {
                            <p id="article-full" class="text-muted mb-2" style="white-space: pre-wrap; display:none;">@Model.Content</p>
                            <button type="button" id="btn-see-more" class="btn btn-sm btn-outline-secondary"
                                    onclick="toggleContent()">
                                <i class="bi bi-chevron-down mr-1"></i> See more
                            </button>
                        }
                    </div>
                </div>
                <script>
                    function toggleContent() {
                        var preview = document.getElementById('article-preview');
                        var full = document.getElementById('article-full');
                        var btn = document.getElementById('btn-see-more');
                        var expanded = full.style.display !== 'none';
                        preview.style.display = expanded ? '' : 'none';
                        full.style.display = expanded ? 'none' : '';
                        btn.innerHTML = expanded
                            ? '<i class="bi bi-chevron-down mr-1"></i> See more'
                            : '<i class="bi bi-chevron-up mr-1"></i> See less';
                    }
                </script>
            }

            <!-- 5. Explanation Card -->
            <div class="card shadow-sm mb-4" style="background: #fff9f9;">
                <div class="card-body">
                    <h5 class="card-title font-weight-bold mb-2">What does this mean?</h5>
                    @if (Model.BadgeClass == "danger")
                    {
                        <p class="text-danger mb-0">
                            The model detected strong indicators of misinformation — sensationalist language,
                            unverified claims, and patterns consistent with fabricated content.
                            We recommend <strong>not sharing</strong> this article until claims are independently verified.
                        </p>
                    }
                    else if (Model.BadgeClass == "success")
                    {
                        <p class="text-success mb-0">
                            The language, structure, and content of this article align with patterns found in credible journalism.
                            No significant signs of fabrication were detected.
                            Always verify critical claims with primary sources.
                        </p>
                    }
                    else
                    {
                        <p class="text-warning mb-0">
                            The model's confidence is below the 75% threshold required for a definitive verdict.
                            This is common for opinion pieces, satire, or niche topics outside the training distribution.
                            Use your own judgment and consult additional sources.
                        </p>
                    }
                </div>
            </div>

            <!-- 6. Navigation Row -->
            <div class="d-flex justify-content-between flex-wrap">
                <a href="@Url.Action("Submit", "Article")" class="btn btn-accent">
                    <i class="bi bi-arrow-left mr-1"></i> Analyze Another
                </a>
                <a href="@Url.Action("Index", "Article")" class="btn btn-outline-secondary">
                    View History
                </a>
            </div>

        </div>
    </div>
</div>
